# المنفذ (تضبطه الاستضافة غالبًا)
PORT=3000
# رابط اتصال PostgreSQL (من Neon: Connection string). للتجربة المحلية مثلًا:
# postgres://user:password@localhost:5432/cement?sslmode=disable
DATABASE_URL=
# حساب المدير الأول: يُنشأ تلقائيًا عند أول تشغيل إذا لم يوجد أي مستخدم
ADMIN_USER=admin
ADMIN_PASSWORD=غيّر-هذه-الكلمة-فورًا
# خلف وكيل الاستضافة (Render/Railway/Nginx)
TRUST_PROXY=1
# للاختبارات المحلية فقط (قاعدة PostgreSQL فارغة للتجارب)
# TEST_DATABASE_URL=postgres://cement:cement@localhost:5432/cement_test?sslmode=disable
